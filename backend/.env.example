# Development only. Copy to backend/.env for host-based development.
# Docker Compose supplies its own database settings.
DB_NAME=verity
DB_USER=verity
DB_PASSWORD=verity_dev
DB_HOST=127.0.0.1
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production additionally requires a generated SECRET_KEY (50+ characters),
# a unique DB_PASSWORD, and explicit ALLOWED_HOSTS. See INSTALL.md.
# SECRET_KEY=
# ALLOWED_HOSTS=verity.example.com
# TRUST_PROXY_HEADERS=True
